{
  "name": "statline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "tsc -b && rm -rf dist && bun build ./index.html --outdir dist --production --public-path / --env 'PUBLIC_*' && cp -R public/. dist/",
    "preview": "bun server.ts --prod",
    "typecheck": "tsc -b",
    "fixtures": "bun scripts/make-fixtures.ts",
    "logos": "bun scripts/make-logos.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
